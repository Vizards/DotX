{
  "name": "@dotx/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "check": "pnpm types:generate && tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "dev": "wrangler dev",
    "build": "esbuild src/worker.ts --bundle --platform=browser --target=es2023 --format=esm --conditions=workerd,worker,browser '--external:node:*' '--external:cloudflare:*' --outfile=dist/worker.mjs",
    "build:worker": "wrangler deploy --dry-run",
    "types:generate": "mkdir -p types && wrangler types types/cloudflare.d.ts --include-env=false"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.3",
    "@dotx/shared": "workspace:*",
    "@modelcontextprotocol/server": "2.3.1",
    "semver": "7.8.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/semver": "7.8.0",
    "esbuild": "0.28.2",
    "wrangler": "4.151.0"
  },
  "license": "MIT"
}
