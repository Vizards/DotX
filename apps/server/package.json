{
  "name": "@dotx/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "check": "pnpm types:generate && tsc -p tsconfig.worker.json && tsc -p tsconfig.tools.json && tsc -p tsconfig.test.json",
    "test": "node --test --test-timeout=30000 'test/**/*.test.ts'",
    "dev": "wrangler dev",
    "build": "pnpm --filter @dotx/web build && pnpm build:code && pnpm build:tools && rm -rf dist/public && mkdir -p dist/public && cp -R ../web/dist/. dist/public/ && cp -R public/. dist/public/",
    "build:worker": "pnpm build && wrangler deploy --dry-run",
    "types:generate": "mkdir -p types && wrangler types types/cloudflare.d.ts --include-env=false",
    "build:code": "esbuild src/worker.ts --bundle --platform=browser --target=es2023 --format=esm --conditions=workerd,worker,browser --loader:.md=text '--external:node:*' '--external:cloudflare:*' --outfile=dist/worker.mjs",
    "build:tools": "esbuild tools/admin.ts --bundle --platform=node --target=node24 --format=esm --outfile=dist/admin.mjs"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.3",
    "@dotx/shared": "workspace:*",
    "@modelcontextprotocol/server": "2.3.1",
    "semver": "7.8.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/semver": "7.8.0",
    "esbuild": "0.28.2",
    "wrangler": "4.151.0"
  },
  "license": "MIT"
}
