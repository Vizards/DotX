{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dotx-server",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-14",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.md"],
      "fallthrough": true
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "DEVICES",
        "class_name": "DeviceHub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DeviceHub"]
    }
  ],
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV"
    }
  ],
  "vars": {
    "PUBLIC_ORIGIN": "http://localhost:8787",
    "RELEASE_REPOSITORY": "",
    "RELEASE_CHANNEL": "stable",
    "RECORD_RETENTION_DAYS": "30",
    "SERVICE_ID": "00000000-0000-4000-8000-000000000002",
    "CF_ACCOUNT_ID": "",
    "CF_WORKER_ID": "",
    "CF_WORKER_NAME": "dotx-server"
  },
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": false,
      "persist": true
    },
    "traces": {
      "enabled": false
    }
  },
  "assets": {
    "directory": "./dist/public",
    "binding": "ASSETS",
    "run_worker_first": ["/*", "!/assets/*", "!/branding/*"],
    "html_handling": "none",
    "not_found_handling": "none"
  }
}
