{
  "name": "dotx",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "test": "pnpm --filter @dotx/server test",
    "check": "pnpm -r check",
    "build": "pnpm -r build",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings apps packages",
    "lint:fix": "oxlint --fix apps packages"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "typescript": "7.0.2"
  },
  "version": "0.0.1",
  "license": "MIT"
}
